#!/usr/bin/env bash
set -euo pipefail

CONFIG_FILE="/etc/tlp.d/99-battery-thresholds.conf"

# Define menu options
options="0%  -> 100%
50% -> 90%
50% -> 85%
50% -> 80%
Stop charging"

# Display fuzzel menu
choice=$(echo "$options" | fuzzel --dmenu --prompt "Battery Threshold: ")

# Exit gracefully if cancelled (Escape or empty choice)
[[ -z "$choice" ]] && exit 0

case "$choice" in
    "Stop charging")
        start=0
        stop=1
        msg="Charging forced OFF"
        ;;
    *)
        # Extract numbers using regex matching
        if [[ "$choice" =~ ([0-9]+)%\ +-\>\ +([0-9]+)% ]]; then
            start="${BASH_REMATCH[1]}"
            stop="${BASH_REMATCH[2]}"
            msg="Threshold set to ${start}% - ${stop}%"
        else
            notify-send -u critical "Battery Profile" "Invalid option selected."
            exit 1
        fi
        ;;
esac

# Write config in a single privileged command
sudo tee "$CONFIG_FILE" > /dev/null <<EOF
# Generated by Sway Battery Script
START_CHARGE_THRESH_BAT0=$start
STOP_CHARGE_THRESH_BAT0=$stop
EOF

# Apply threshold changes dynamically to BAT0
if sudo tlp setcharge BAT0 > /dev/null 2>&1; then
    notify-send -i battery-good "TLP Battery Profile" "$msg"
else
    notify-send -u critical "TLP Battery Profile" "Failed to apply threshold."
    exit 1
fi
