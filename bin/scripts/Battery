#!/usr/bin/env bash
set -euo pipefail

BAT_PATH="/sys/class/power_supply/BAT0"

# Verify kernel battery interface exists
if [[ ! -d "$BAT_PATH" ]]; then
    notify-send -u critical "Battery Profile" "BAT0 interface not found at $BAT_PATH"
    exit 1
fi

# Define menu options
options="0%  -> 100%
50% -> 90%
50% -> 85%
50% -> 80%
Stop charging"

# Display fuzzel menu
choice=$(echo "$options" | fuzzel --dmenu --prompt "Battery Threshold: ")

# Exit gracefully if cancelled
[[ -z "$choice" ]] && exit 0

case "$choice" in
    "Stop charging")
        start=0
        stop=1
        msg="Charging forced OFF"
        ;;
    *)
        # Extract numbers using regex matching
        if [[ "$choice" =~ ([0-9]+)%\ +-\>\ +([0-9]+)% ]]; then
            start="${BASH_REMATCH[1]}"
            stop="${BASH_REMATCH[2]}"
            msg="Threshold set to ${start}% - ${stop}%"
        else
            notify-send -u critical "Battery Profile" "Invalid option selected."
            exit 1
        fi
        ;;
esac

# Note: Set start threshold to 0 first to prevent kernel errors if new stop < current start
if echo 0 | sudo tee "$BAT_PATH/charge_control_start_threshold" > /dev/null && \
   echo "$stop" | sudo tee "$BAT_PATH/charge_control_end_threshold" > /dev/null && \
   echo "$start" | sudo tee "$BAT_PATH/charge_control_start_threshold" > /dev/null; then
    notify-send -i battery-good "Battery Profile" "$msg"
else
    notify-send -u critical "Battery Profile" "Failed to apply threshold."
    exit 1
fi