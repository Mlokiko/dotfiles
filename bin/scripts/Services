#!/bin/bash
#
# A Fuzzel script to manage systemd services (System & User units) on Sway / Arch Linux.
# Re-loops back to the service menu after executing actions or pressing Escape in Stage 2.
#
# Dependencies: fuzzel, systemd, pkexec (polkit), libnotify (notify-send)
#

# --- 💡 EDIT THIS LIST ---
SERVICES=(
    "bluetooth.service"
    "tailscaled.service"
    "udisks2.service"
    "libvirtd.service"
    "syncthing.service"
)
# --- END OF CONFIGURATION ---


# 1. Terminal fallback detection for Wayland/Sway
TERM_CMD="${TERMINAL:-$(command -v foot || command -v alacritty || command -v kitty || echo x-terminal-emulator)}"

# Helper function: Check if a unit exists as a user service
is_user_service() {
    systemctl --user cat "$1" &>/dev/null
}


# --- MAIN LOOP ---
while true; do

    # 2. Generate/Refresh menu list with current service status
    declare -a MENU_LINES=()

    for s in "${SERVICES[@]}"; do
        # Determine unit scope
        if is_user_service "$s"; then
            CMD_PREFIX="systemctl --user"
            SCOPE="[user]"
        else
            CMD_PREFIX="systemctl"
            SCOPE="[sys] "
        fi

        # Get Active State
        if $CMD_PREFIX is-active --quiet "$s"; then
            STATUS_A="Active"
            ICON_A="🟢"
        else
            STATUS_A="Inactive"
            ICON_A="🔴"
        fi

        # Get Enabled State
        if $CMD_PREFIX is-enabled --quiet "$s"; then
            STATUS_E="Enabled"
            ICON_E="🔵"
        else
            STATUS_E="Disabled"
            ICON_E="⚪️"
        fi

        # Create formatted line
        LINE=$(printf "%-22s %s [ %s %-8s | %s %-8s ]" "$s" "$SCOPE" "$ICON_A" "$STATUS_A" "$ICON_E" "$STATUS_E")
        MENU_LINES+=("$LINE")
    done


    # 3. Show Fuzzel - Stage 1: Select Service
    MAIN_SELECTION=$(printf "%s\n" "${MENU_LINES[@]}" | fuzzel --dmenu --prompt="Manage Service: " --lines=10)

    # Exit the script entirely if user pressed Escape at main service selection
    [ -z "$MAIN_SELECTION" ] && exit 0

    # Extract service name (takes the first word before spaces)
    SERVICE="${MAIN_SELECTION%% *}"

    # Error check
    [ -z "$SERVICE" ] && notify-send "Fuzzel Script Error" "Could not parse service name." && exit 1


    # 4. Show Fuzzel - Stage 2: Select Action
    ACTIONS="Start\nStop\nEnable\nDisable\nRestart\nStatus"

    ACTION_SELECTION=$(printf "%b" "$ACTIONS" | fuzzel --dmenu --prompt="$SERVICE Action: ")

    # If user pressed Escape here, go back to Stage 1 (Select Service)
    [ -z "$ACTION_SELECTION" ] && continue


    # 5. Determine execution command prefix
    if is_user_service "$SERVICE"; then
        SYS_CMD="systemctl --user"
    else
        SYS_CMD="pkexec systemctl"
    fi


    # 6. Execute the selected action
    case "$ACTION_SELECTION" in
        Start)
            $SYS_CMD start "$SERVICE" && notify-send "$SERVICE" "Service started"
            ;;
        Stop)
            $SYS_CMD stop "$SERVICE" && notify-send "$SERVICE" "Service stopped"
            ;;
        Enable)
            $SYS_CMD enable "$SERVICE" && notify-send "$SERVICE" "Service enabled on boot"
            ;;
        Disable)
            $SYS_CMD disable "$SERVICE" && notify-send "$SERVICE" "Service disabled on boot"
            ;;
        Restart)
            $SYS_CMD restart "$SERVICE" && notify-send "$SERVICE" "Service restarted"
            ;;
        Status)
            if is_user_service "$SERVICE"; then
                STATUS_CMD="systemctl --user"
            else
                STATUS_CMD="systemctl"
            fi
            "$TERM_CMD" -e bash -c "$STATUS_CMD status '$SERVICE'; echo; read -p 'Press Enter to exit...' -n1"
            ;;
        *)
            notify-send "Invalid action selected"
            ;;
    esac

    # The loop automatically repeats here, re-polling systemctl status
    # so active/inactive icons update instantly on screen.
done
