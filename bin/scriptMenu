#!/bin/bash

FOLDER="$HOME/bin/scripts"

# Find executable files OR symlinks in the target directory
files=$(find "$FOLDER" -maxdepth 1 \( -type f -o -type l \) -executable -printf "%f\n")

# Prompt user via fuzzel
selection=$(echo "$files" | fuzzel --dmenu --prompt "Select script: ")

# Execute selected script if non-empty
if [[ -n "$selection" ]]; then
  "$FOLDER/$selection" &
fi
